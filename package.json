{
  "name": "chores",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "dev": "next dev",
    "email:dev": "XDG_CONFIG_HOME=.react-email/config email dev --dir src/lib/email/templates --port 3001",
    "seed:chores": "node scripts/seed-chores.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && echo \"Type check passed!\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_SUITE=smoke playwright test --project smoke",
    "test:e2e:regressions": "E2E_SUITE=regressions playwright test --project regressions",
    "test:e2e:contention": "E2E_SUITE=contention playwright test --project contention",
    "e2e:install": "playwright install chromium",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:write": "biome format . --write",
    "dev:check": "yarn format && yarn lint && yarn test && yarn typecheck",
    "dev:fix": "yarn format:write && yarn lint:fix && yarn test && yarn typecheck"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.21",
    "drizzle-orm": "0.45.4",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@react-email/ui": "6.11.11",
    "@tailwindcss/postcss": "4.3.5",
    "@types/luxon": "3.7.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "31.0.0",
    "npm-check-updates": "23.1.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

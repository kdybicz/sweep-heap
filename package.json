{
  "name": "chores",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "dev": "next dev",
    "email:dev": "XDG_CONFIG_HOME=.react-email/config email dev --dir src/lib/email/templates --port 3001",
    "seed:chores": "node scripts/seed-chores.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && echo \"Type check passed!\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:write": "biome format . --write",
    "dev:check": "yarn format && yarn lint && yarn test && yarn typecheck",
    "dev:fix": "yarn format:write && yarn lint:fix && yarn test && yarn typecheck"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.9",
    "@tanstack/react-query": "5.101.2",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "luxon": "3.7.2",
    "next": "16.2.9",
    "nodemailer": "8.0.11",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@react-email/preview-server": "5.2.11",
    "@tailwindcss/postcss": "4.3.2",
    "@types/luxon": "3.7.2",
    "@types/node": "24.13.2",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "react-email": "5.2.11",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "resolutions": {
    "fast-uri": "3.1.3",
    "next": "16.2.9",
    "nodemailer": "9.0.3",
    "undici": "7.28.0",
    "vite": "8.0.16",
    "ws": "8.21.0"
  }
}

{
  "name": "chores",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "dev": "next dev",
    "email:dev": "XDG_CONFIG_HOME=.react-email/config email dev --dir src/lib/email/templates --port 3001",
    "seed:chores": "node scripts/seed-chores.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && echo \"Type check passed!\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:write": "biome format . --write",
    "dev:check": "yarn format && yarn lint && yarn test && yarn typecheck",
    "dev:fix": "yarn format:write && yarn lint:fix && yarn test && yarn typecheck"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "luxon": "3.7.2",
    "next": "16.3.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@react-email/preview-server": "5.2.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "react-email": "5.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "brace-expansion": "5.0.9",
    "engine.io": "6.6.9",
    "ip-address": "10.4.0",
    "nanoid": "3.3.17",
    "next": "16.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "ws": "8.21.0"
  }
}
